# AlphaStream 本地凭据模板
#
# 用法：
#   1. cp Src/.env.example Src/.env
#   2. 把下面两项填成真实值
#   3. Src/.env 已被 .gitignore 忽略，不要提交、不要贴到聊天/issue 里
#
# GMAIL_APP_PASSWORD 必须是 Google 账号的「应用专用密码」（16 位，形如 xxxx xxxx xxxx xxxx），
# 不是账号登录密码。生成入口：https://myaccount.google.com/apppasswords
# 需要先开启两步验证才能生成。只给这个用途开一个，泄露时单独撤销即可。

GMAIL_USER=your_account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
